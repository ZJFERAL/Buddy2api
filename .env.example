# Memorix compatibility environment variables
# Prefer ~/.memorix/config.toml or <git-root>/memorix.toml for normal setup.

# Optional HTTP rerank (Cohere-compatible POST {base_url}/rerank)
# MEMORIX_RERANK_PROVIDER=http
# MEMORIX_RERANK_MODEL=rerank-model
# MEMORIX_RERANK_BASE_URL=https://api.example.com/v1
# MEMORIX_RERANK_API_KEY=  # required when BASE_URL is not the memory LLM endpoint

# Optional memory LLM simple key (does not apply to embedding or agent lanes)
# MEMORIX_API_KEY=sk-your-key-here

# Compatibility variables (lowest priority)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...
